# Adresse publique du site (liens des e-mails). Sur Vercel, vous pouvez la laisser vide :
# l'URL de production est détectée automatiquement.
BASE_URL=http://localhost:3000
PORT=3000

# E-mail du propriétaire : reçoit les notifications de devis ET les clés d'accès admin
OWNER_EMAIL=proprietaire@example.com

# Base Postgres Neon (obligatoire sur Vercel). En local, laissez vide : une base de test est créée dans ./data
DATABASE_URL=

# Indicatif pays pour les liens WhatsApp (Algérie = 213) et fuseau horaire d'affichage
COUNTRY_CODE=213
TIME_ZONE=Africa/Algiers

# Page Instagram de la boutique
INSTAGRAM_URL=https://www.instagram.com/flocart_creation

# SMTP (laisser vide en local = les e-mails sont affichés dans la console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="FlocArt <no-reply@example.com>"
